{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "overview",
  // Live deploy: numbers.margins.me. Kept off workers.dev like the original manual deploy.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "numbers.margins.me", "custom_domain": true }],
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Static files skip the Worker. Anything else (client routes, unknown paths) runs it so missing pages return a real 404.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minilytics",
      // Live D1 "overview". database_name stays "minilytics" so package.json scripts work unchanged; the id decides the target.
      "database_id": "b42fb130-1b47-419f-b90c-37e9cc31e7a4",
      "migrations_dir": "migrations"
    }
  ]
}
